# ─── Dependencies ────────────────────────────────────────────────────────────
# Installed by npm/yarn/pnpm – never commit these
node_modules/
.pnp
.pnp.js

# ─── Build output ─────────────────────────────────────────────────────────────
# Vite production build output
dist/
dist-ssr/

# ─── Local dev / cache ────────────────────────────────────────────────────────
# Vite cache
.vite/

# ─── Environment variables ────────────────────────────────────────────────────
# May contain API keys, secrets – never commit
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Lock files (optional – keep if you want reproducible installs) ───────────
# Uncomment the one you don't use:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ─── Testing ──────────────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── TypeScript ───────────────────────────────────────────────────────────────
# Type-check cache
*.tsbuildinfo

# ─── OS-generated files ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Storybook ────────────────────────────────────────────────────────────────
storybook-static/

# ─── Misc ─────────────────────────────────────────────────────────────────────
# Local HTTPS cert files (if using vite --https)
*.pem
